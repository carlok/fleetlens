FLEETLENS_INVENTORY=ansible/inventories/example/hosts.ini
FLEETLENS_RAW_REPORT=reports/raw-ansible.json
FLEETLENS_JSON_REPORT=reports/latest.json
FLEETLENS_MARKDOWN_REPORT=reports/latest.md

FLEETLENS_RUNNER_BACKEND=shell

FLEETLENS_EMAIL_ENABLED=false
FLEETLENS_EMAIL_SMTP_HOST=smtp.example.com
FLEETLENS_EMAIL_SMTP_PORT=587
FLEETLENS_EMAIL_SMTP_USERNAME=
FLEETLENS_EMAIL_SMTP_PASSWORD=
FLEETLENS_EMAIL_FROM=fleetlens@example.com
FLEETLENS_EMAIL_TO=admin@example.com
FLEETLENS_EMAIL_USE_TLS=true
FLEETLENS_EMAIL_SUBJECT_PREFIX=[FleetLens]
FLEETLENS_EMAIL_SEND_ON_OK=false
FLEETLENS_EMAIL_SEND_ON_WARNING=true
FLEETLENS_EMAIL_SEND_ON_CRITICAL=true

FLEETLENS_NOTIFICATION_BACKEND=smtp
FLEETLENS_APPRISE_URLS=

FLEETLENS_HEARTBEAT_ENABLED=false
FLEETLENS_HEARTBEAT_START_URL=
FLEETLENS_HEARTBEAT_SUCCESS_URL=
FLEETLENS_HEARTBEAT_FAILURE_URL=

FLEETLENS_ARA_ENABLED=false
ARA_API_CLIENT=http
ARA_API_SERVER=http://ara:8000

